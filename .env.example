# Copy these names into Vercel -> Project -> Settings -> Environment Variables
# (or into a file called ".env.local" if you ever run the site on your own computer).
# Find both Supabase values in: Supabase dashboard -> Project Settings -> API

# Your Supabase "Project URL"  (looks like https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Your Supabase PUBLISHABLE key (starts with sb_publishable_ ; older projects call it
# the "anon" key). It is SAFE to be public because Row Level Security protects your data.
# The variable name stays "ANON_KEY" either way.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your website address (your Vercel address now, your real domain later)
NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# Backup Instagram username, used only until you save one in Admin -> Store Settings
NEXT_PUBLIC_INSTAGRAM_USERNAME=jers10ywala

# NEVER put the Supabase "secret" or "service_role" key in this project.
